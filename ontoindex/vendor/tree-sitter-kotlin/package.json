{
  "name": "tree-sitter-kotlin",
  "version": "0.3.8",
  "description": "Tree-sitter grammar for Kotlin",
  "main": "bindings/node",
  "types": "bindings/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwcd/tree-sitter-kotlin.git"
  },
  "keywords": [
    "tree-sitter",
    "kotlin",
    "grammar"
  ],
  "files": [
    "grammar.js",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "author": "fwcd",
  "license": "MIT",
  "gypfile": true,
  "bugs": {
    "url": "https://github.com/fwcd/tree-sitter-kotlin/issues"
  },
  "homepage": "https://github.com/fwcd/tree-sitter-kotlin#readme",
  "tree-sitter": [
    {
      "scope": "source.kotlin",
      "file-types": [
        "kt",
        "kts"
      ]
    }
  ]
}
